{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@vformjs/shared": ["./packages/shared/src/index.ts"],
      "@vformjs/core": ["./packages/core/src/index.ts"],
      "@vformjs/vue": ["./packages/vue/src/index.ts"],
      "@vformjs/zod": ["./packages/zod/src/index.ts"],
      "@vformjs/element-plus": ["./packages/element-plus/src/index.ts"],
      "@vformjs/element-plus/*": ["./packages/element-plus/src/*"],
      "@vformjs/element-ui": ["./packages/element-ui/src/index.ts"],
      "@vformjs/element-ui/*": ["./packages/element-ui/src/*"]
    }
  },
  "include": [
    "env.d.ts",
    "vitest.config.ts",
    "packages/*/src",
    "packages/*/test",
    "playgrounds/vue3-*/src",
    "playgrounds/vue3-*/vite.config.ts"
  ],
  "exclude": [
    "**/dist/**",
    "**/node_modules/**",
    "playgrounds/vue2-element-ui/**"
  ]
}
