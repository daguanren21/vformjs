{
  "name": "vformjs-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "^22.11 || ^24 || >=26"
  },
  "scripts": {
    "prepare": "husky",
    "agent:discover:collect": "node scripts/agent/discovery.mjs collect",
    "agent:discover:codex": "node scripts/agent/discovery.mjs run --runner codex",
    "agent:discover:omp": "node scripts/agent/discovery.mjs run --runner omp",
    "agent:discover:claude": "node scripts/agent/discovery.mjs run --runner claude",
    "build": "turbo run build --filter=./packages/*",
    "build:play:vue3": "pnpm --filter @vformjs/playground-vue3-element-plus run build",
    "build:play:vue2": "pnpm --filter @vformjs/playground-vue2-element-ui run build",
    "build:play:naive": "pnpm --filter @vformjs/playground-vue3-naive-ui run build",
    "build:play:antd": "pnpm --filter @vformjs/playground-vue3-antd-vue run build",
    "dev:vue3": "pnpm --filter @vformjs/playground-vue3-element-plus run dev",
    "dev:vue2": "pnpm --filter @vformjs/playground-vue2-element-ui run dev",
    "dev:naive": "pnpm --filter @vformjs/playground-vue3-naive-ui run dev",
    "dev:antd": "pnpm --filter @vformjs/playground-vue3-antd-vue run dev",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "typecheck": "turbo run typecheck --filter=./packages/*",
    "lint": "oxlint -c .oxlintrc.json packages playgrounds scripts",
    "lint:fix": "oxlint -c .oxlintrc.json --fix packages playgrounds scripts",
    "test": "vitest run --config vitest.config.ts",
    "test:agent": "node --test scripts/agent/*.test.mjs",
    "test:watch": "vitest --config vitest.config.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:agent && pnpm build && pnpm docs:build && pnpm build:play:vue3 && pnpm build:play:vue2 && pnpm build:play:naive && pnpm build:play:antd",
    "ci": "pnpm run verify",
    "commitlint": "commitlint --edit"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.0",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/node": "^22.19.0",
    "@vformjs/core": "workspace:*",
    "@vformjs/ant-design-vue": "workspace:*",
    "@vformjs/naive-ui": "workspace:*",
    "@vformjs/element-plus": "workspace:*",
    "@vformjs/element-ui": "workspace:*",
    "@vformjs/vue": "workspace:*",
    "@vformjs/zod": "workspace:*",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/test-utils": "2.4.11",
    "element-plus": "^2.14.3",
    "happy-dom": "20.11.2",
    "husky": "^9.1.7",
    "oxlint": "1.76.0",
    "turbo": "^2.5.4",
    "typescript": "catalog:",
    "vitepress": "2.0.0-alpha.18",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-demi": "catalog:",
    "zod": "catalog:"
  }
}
