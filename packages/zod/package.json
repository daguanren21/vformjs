{
  "name": "@vformjs/zod",
  "version": "0.1.0",
  "description": "Zod bridge for vformjs",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../.. packages/zod/test"
  },
  "dependencies": {
    "@vformjs/core": "workspace:^",
    "@vformjs/vue": "workspace:^"
  },
  "peerDependencies": {
    "vue": "^2.7.0 || ^3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "zod": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
