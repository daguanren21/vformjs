{
  "name": "@vformjs/core",
  "version": "0.3.0",
  "description": "Headless form state machine for vformjs",
  "keywords": [
    "vue",
    "vue2",
    "vue3",
    "forms",
    "form-state",
    "typescript",
    "crud"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../.. packages/core/test"
  },
  "dependencies": {},
  "devDependencies": {
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/daguanren21/vformjs.git",
    "directory": "packages/core"
  },
  "homepage": "https://vformjs.vercel.app/",
  "bugs": {
    "url": "https://github.com/daguanren21/vformjs/issues"
  }
}
