{
  "name": "@vformjs/element-ui",
  "version": "0.5.0",
  "description": "element-ui (Vue 2.7) adapter for vformjs (useElForm)",
  "keywords": [
    "vue",
    "vue2",
    "element-ui",
    "forms",
    "form-validation",
    "typescript",
    "crud"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./zod": {
      "import": {
        "types": "./dist/use-zod-form.d.ts",
        "default": "./dist/use-zod-form.js"
      },
      "require": {
        "types": "./dist/use-zod-form.d.cts",
        "default": "./dist/use-zod-form.cjs"
      }
    },
    "./schema": {
      "import": {
        "types": "./dist/use-schema-form.d.ts",
        "default": "./dist/use-schema-form.js"
      },
      "require": {
        "types": "./dist/use-schema-form.d.cts",
        "default": "./dist/use-schema-form.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@standard-schema/spec": "catalog:",
    "@vformjs/core": "workspace:^",
    "@vformjs/vue": "workspace:^",
    "@vformjs/zod": "workspace:^"
  },
  "peerDependencies": {
    "element-ui": ">=2.13.0",
    "vue": "^2.7.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "element-ui": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/daguanren21/vformjs.git",
    "directory": "packages/element-ui"
  },
  "homepage": "https://vformjs.vercel.app/",
  "bugs": {
    "url": "https://github.com/daguanren21/vformjs/issues"
  }
}
